# Supabase (Project Settings > API). Só chaves públicas: a segurança fica no RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Aviso por e-mail a cada pedido de orçamento (opcional). Conta em resend.com > API Keys.
# NOTIFY_EMAIL aceita vários e-mails separados por vírgula.
RESEND_API_KEY=
NOTIFY_EMAIL=
# Remetente com domínio verificado no Resend. Vazio = remetente de teste (só entrega para o dono da conta).
NOTIFY_FROM=
